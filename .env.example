# Copy to .env (and add the same keys in Vercel > Project > Settings > Environment Variables).
# Values come from Firebase console > Project settings > Your apps > Web app.
# They are public client identifiers, not secrets — access control lives in firestore.rules.
# Leave empty to play with device-only saves.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
